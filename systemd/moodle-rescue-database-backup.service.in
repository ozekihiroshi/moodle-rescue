[Unit]
Description=Moodle Rescue database backup producer
Documentation=https://github.com/ozekihiroshi/moodle-rescue/blob/main/docs/database-backup.md
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
WorkingDirectory=@REPOSITORY_ROOT@
ExecStart=/bin/sh @REPOSITORY_ROOT@/scripts/database-backup-now.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
UMask=0077
TimeoutStartSec=2h
