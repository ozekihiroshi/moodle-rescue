# Local defaults. Copy this file to .env and replace every CHANGE_ME value.
MOODLE_WWWROOT=http://localhost:8083
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME_MOODLE_DB_PASSWORD
MOODLE_DB_ROOT_PASSWORD=CHANGE_ME_MOODLE_DB_ROOT_PASSWORD

# Used only by the local MinIO service. These credentials must never be
# entered into Moodle settings or committed to Git.
MINIO_ROOT_USER=moodle-local-access
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=moodle-backups

# Least-privilege credentials provisioned by the local minio-init service.
S3_ACCESS_KEY_ID=moodle-backup-writer
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY

# Isolated ZIP-install release gate. The object key must identify a verified
# Moodle-generated course backup in the local MinIO bucket.
RELEASE_TEST_DB_NAME=moodle_release_test
RELEASE_TEST_DB_USER=moodle_release_test
RELEASE_TEST_DB_PASSWORD=CHANGE_ME_RELEASE_TEST_DB_PASSWORD
RELEASE_TEST_DB_ROOT_PASSWORD=CHANGE_ME_RELEASE_TEST_DB_ROOT_PASSWORD
RELEASE_TEST_ADMIN_PASSWORD=CHANGE_ME_RELEASE_TEST_ADMIN_PASSWORD
RELEASE_TEST_WWWROOT=http://localhost:8084
RELEASE_TEST_OBJECT_KEY=CHANGE_ME_RELEASE_TEST_OBJECT_KEY

# Production Traefik settings. They are ignored by docker-compose.local.yml.
MOODLE_HOST=moodle.example.com
TRAEFIK_NETWORK=CHANGE_ME_TRAEFIK_NETWORK
