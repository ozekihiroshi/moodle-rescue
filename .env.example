# Local defaults. Copy this file to .env and replace every CHANGE_ME value.
MOODLE_WWWROOT=http://localhost:8083
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME_MOODLE_DB_PASSWORD
MOODLE_DB_ROOT_PASSWORD=CHANGE_ME_MOODLE_DB_ROOT_PASSWORD

# Used only by the local MinIO service. These credentials must never be
# entered into Moodle settings or committed to Git.
MINIO_ROOT_USER=moodle-local-access
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=moodle-backups

# Least-privilege credentials provisioned by the local minio-init service.
S3_ACCESS_KEY_ID=moodle-backup-writer
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY
