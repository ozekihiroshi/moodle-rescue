# General Moodle plugin UI lifecycle test. Copy to .env.ui-test, replace every
# CHANGE_ME value, and never commit the resulting file.
UI_TEST_DB_NAME=moodle_ui_test
UI_TEST_DB_USER=moodle_ui_test
UI_TEST_DB_PASSWORD=CHANGE_ME_UI_TEST_DB_PASSWORD
UI_TEST_DB_ROOT_PASSWORD=CHANGE_ME_UI_TEST_DB_ROOT_PASSWORD
UI_TEST_ADMIN_PASSWORD=CHANGE_ME_UI_TEST_ADMIN_PASSWORD
UI_TEST_WWWROOT=http://localhost:8085
UI_TEST_MOODLE_PORT=8085
