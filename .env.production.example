# EC2 production-shaped deployment. Copy this file to .env and replace every
# CHANGE_ME value. Do not add AWS access keys: the containers use the EC2
# instance role through the AWS SDK credential provider chain.
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME_MOODLE_DB_PASSWORD
MOODLE_DB_ROOT_PASSWORD=CHANGE_ME_MOODLE_DB_ROOT_PASSWORD

# Public HTTPS hostname and the existing external Traefik Docker network.
MOODLE_HOST=moodle.example.org
TRAEFIK_NETWORK=rescue_proxy
TRAEFIK_CERT_RESOLVER=myresolver
AWS_REGION=ap-northeast-1
