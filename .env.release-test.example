# ZIP-install release gate overrides. Load this file after the local .env.
# The object key must identify a verified Moodle-generated course backup in
# the local MinIO bucket.
RELEASE_TEST_DB_NAME=moodle_release_test
RELEASE_TEST_DB_USER=moodle_release_test
RELEASE_TEST_DB_PASSWORD=CHANGE_ME_RELEASE_TEST_DB_PASSWORD
RELEASE_TEST_DB_ROOT_PASSWORD=CHANGE_ME_RELEASE_TEST_DB_ROOT_PASSWORD
RELEASE_TEST_ADMIN_PASSWORD=CHANGE_ME_RELEASE_TEST_ADMIN_PASSWORD
RELEASE_TEST_WWWROOT=http://localhost:8084
RELEASE_TEST_OBJECT_KEY=CHANGE_ME_RELEASE_TEST_OBJECT_KEY

# Read-only hand-off volume produced by docker-compose.local.yml.
RELEASE_TEST_DATABASE_ARTIFACT_VOLUME=moodle-rescue-local_moodle_database_artifacts
